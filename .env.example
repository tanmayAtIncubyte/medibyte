# MediByte environment.
# Local dev needs NONE of these — the app runs fully offline (in-memory store,
# access gate disabled). These are for the deployed instance (see docs/ADMIN-RUNBOOK.md §7).

# Signs the auth + candidate-access cookies. Any long random string.
SESSION_SECRET=

# Upstash Redis (console.upstash.com → REST API). When both are set, per-candidate
# state persists across serverless requests and the time-boxed access gate turns on.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
